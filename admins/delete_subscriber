
<?php
require_once("../includes/db.php"); // update this path if needed

// Show all PHP errors for debugging
ini_set('display_errors', 1);
error_reporting(E_ALL);

if (isset($_GET['id'])) {
    $id = intval($_GET['id']);

    $stmt = $conn->prepare("DELETE FROM newsletter_subscribers WHERE id = ?");
    if (!$stmt) {
        echo "prepare_failed: " . $conn->error;
        exit;
    }

    $stmt->bind_param("i", $id);

    if ($stmt->execute()) {
        echo "success";
    } else {
        echo "execute_failed: " . $stmt->error;
    }

    $stmt->close();
    $conn->close();
} else {
    echo "no_id";
}
?>
